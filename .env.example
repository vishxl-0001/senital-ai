# ============================================
# Sentinel AI — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# ----- Database -----
DATABASE_URL=postgresql+asyncpg://postgres:sentinel_dev@localhost:5432/sentinel_ai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=sentinel_dev
POSTGRES_DB=sentinel_ai

# ----- Redis -----
REDIS_URL=redis://localhost:6379/0

# ----- OpenAI -----
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o

# ----- Slack -----
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_APP_TOKEN=xapp-your-slack-app-token
SLACK_SIGNING_SECRET=your-signing-secret

# ----- GitHub -----
GITHUB_TOKEN=ghp_your-github-token
GITHUB_ORG=your-org-name

# ----- Monitoring / Prometheus -----
# Base URL of your Prometheus server. If unset, metric queries return no_data
# (the agents will NOT reason on fabricated metrics).
# PROMETHEUS_URL=http://prometheus:9090
# Dev-only: serve canned sample metric series (requires APP_ENV=development).
PROMETHEUS_ALLOW_MOCK=false

# ----- App Settings -----
APP_ENV=development
APP_PORT=8000
LOG_LEVEL=INFO

# ----- Clerk Auth (dashboard) -----
# Frontend (Next.js) keys — used by the dashboard build:
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your-clerk-publishable-key
CLERK_SECRET_KEY=sk_test_your-clerk-secret-key
# Backend session-JWT verification. The publishable key is public; the backend
# derives the Clerk issuer + JWKS URL from it automatically. Override only if
# you front Clerk with a custom domain:
CLERK_PUBLISHABLE_KEY=pk_test_your-clerk-publishable-key
# CLERK_ISSUER=https://your-app.clerk.accounts.dev
# CLERK_JWKS_URL=https://your-app.clerk.accounts.dev/.well-known/jwks.json

# ----- Security -----
SECRET_KEY=change-this-to-a-random-string-in-production
